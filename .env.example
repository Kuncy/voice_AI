# Shared LiveKit project credentials
APP_URL=http://localhost:3000
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=heyvera

# Used to sign short-lived browser session handles (at least 32 characters)
SESSION_SECRET=

# Protects /conversations, /requests and /settings. Generate with: pnpm auth:hash '<password>'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Must be overwritten by the ingress proxy; untrusted forwarding headers are not used.
TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Phase 2 provider credentials
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=flux-general-multi
DEEPGRAM_EOT_THRESHOLD=0.75
DEEPGRAM_EOT_TIMEOUT_MS=5000
DEEPGRAM_TTS_MODEL=aura-2-viktoria-de
DEEPGRAM_TTS_FALLBACK_MODEL=aura-2-elara-de
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Phase 3 persistence
POSTGRES_DB=heyvera
POSTGRES_USER=heyvera
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://heyvera:change-me@postgres:5432/heyvera

# Session guardrails
MAX_SESSION_MS=600000
IDLE_TIMEOUT_MS=60000
MAX_TURNS=40
RECONNECT_GRACE_MS=60000
INTERRUPTION_MIN_DURATION_MS=400
INTERRUPTION_MIN_WORDS=1
DATA_RETENTION_DAYS=90
