{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "LIVEKIT_URL",
    "LIVEKIT_API_KEY",
    "LIVEKIT_API_SECRET",
    "LIVEKIT_AGENT_NAME",
    "SESSION_SECRET",
    "DATABASE_URL",
    "POSTGRES_DB",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "DEEPGRAM_API_KEY",
    "DEEPGRAM_STT_MODEL",
    "DEEPGRAM_TTS_MODEL",
    "DEEPGRAM_TTS_FALLBACK_MODEL",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "MAX_SESSION_MS",
    "IDLE_TIMEOUT_MS",
    "MAX_TURNS",
    "RECONNECT_GRACE_MS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
